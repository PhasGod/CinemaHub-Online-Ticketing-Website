# Database chính trên TiDB Cloud
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"

# Shadow Database cho Prisma Migrate
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/SHADOW_DATABASE?sslaccept=strict"

# Các cấu hình mặc định khác của CinemaHub
PORT=3000
CLIENT_URL=http://localhost:8443

# Cấu hình gửi Email (Gmail SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=5topcinema.service@gmail.com
SMTP_PASS=
MAIL_FROM="5TOP CINEMA <5topcinema.service@gmail.com>"
EMAIL_FROM="CinemaHub - 5TOP CINEMA <5topcinema.service@gmail.com>"

# Cấu hình cổng thanh toán MoMo Sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:8443/booking/success
MOMO_IPN_URL=http://localhost:3000/api/payments/momo/ipn
