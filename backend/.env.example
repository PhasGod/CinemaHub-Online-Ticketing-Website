# MySQL application database. Do not commit your real password in backend/.env.
DATABASE_URL="mysql://APP_USER:APP_PASSWORD@localhost:3306/cinemahub_db"

# Use a separate database for Prisma migration shadow operations.
SHADOW_DATABASE_URL="mysql://APP_USER:APP_PASSWORD@localhost:3306/cinemahub_shadow"

PORT=3000
CLIENT_URL="http://localhost:8443"
NODE_ENV="development"
